@* Legend of the chart colours in the chosen chart style (also printed). *@
<svg class="@Gantt.ChartCss(Prefs.Chart, IsDark)" height="24" width="100%">
    <GanttPatterns Id="legend" />
    @{ var x = 0d; }
    @foreach (var (shapes, label) in Entries())
    {
        var position = x;
        x += Slot(label);
        @foreach (var shape in shapes(position))
        {
            <GanttShapeView Shape="shape" />
        }
        <g><text x="@F(position + 34)" y="15">@label</text></g>
    }
</svg>
<svg class="@Gantt.ChartCss(Prefs.Chart, IsDark)" height="24" width="100%">
    @{ var tx = 0d; }
    @foreach (var type in Enum.GetValues<JobType>())
    {
        var position = tx;
        tx += 170;
        <rect class="@($"tf {Gantt.TypeCss(type)}")" x="@F(position + 1)" y="6" width="@(Prefs.Chart == ChartStyle.TypeColor ? 26 : 6)" height="11" rx="2" />
        <g><text x="@F(position + 34)" y="15">@T["JobType_" + type]</text></g>
    }
</svg>

@code {
    [Parameter] public bool History { get; set; }
    [CascadingParameter] public UiPreferences Prefs { get; set; } = new();
    [CascadingParameter(Name = "IsDark")] public bool IsDark { get; set; }

    private const double Mid = 11.5;

    /// <summary>Width of a legend entry: swatch, label (about 6.3 px per character at 11 px) and a gap; at least 170 px.</summary>
    private static double Slot(string label) => Math.Ceiling(Math.Max(170, 34 + label.Length * 6.3 + 18));

    /// <summary>SVG numbers always with a dot: in Polish "6,5" would split a coordinate in two.</summary>
    private static string F(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static GanttShape Bar(double x, string css, double h = 12, double w = 26, string? fill = null, double opacity = 1) =>
        new(GanttShapeKind.Rect, css, x, Mid - h / 2, w, h, Fill: fill, Opacity: opacity, Rx: 2.5);

    private static GanttShape Triangle(double x) =>
        new(GanttShapeKind.Polygon, "misfire", x, 0, Points: $"{F(x + 13)},{F(Mid - 5)} {F(x + 18)},{F(Mid + 4)} {F(x + 8)},{F(Mid + 4)}");

    private const string Hatch = "url(#legend-hatch)";
    private const string Paused = "url(#legend-phatch)";

    private IEnumerable<(Func<double, IEnumerable<GanttShape>> Shapes, string Label)> Entries()
    {
        string R(string result) => T["Result_" + result];
        var style = Prefs.Chart;
        if (!History)
        {
            return style switch
            {
                ChartStyle.TypeColor =>
                [
                    (x => [Bar(x, "tf t-import")], T["Gantt_Planned"]),
                    (x => [Bar(x, "band-fill tf t-import"), Bar(x, "band-edge ts t-import")], T["Gantt_Frequent"]),
                    (x => [Bar(x, "hatch", fill: Paused)], T["State_Paused"])
                ],
                ChartStyle.Heatmap =>
                [
                    (x => [Bar(x, "tile tf t-import", 14, 12, opacity: .35), Bar(x + 14, "tile tf t-import", 14, 12)], T["Gantt_PlannedCount"]),
                    (x => [Bar(x, "tile hatch", 14, fill: Paused)], T["State_Paused"])
                ],
                ChartStyle.Calm =>
                [
                    (x => [Bar(x + 11, "tf t-import", 10, 3)], T["Gantt_Planned"]),
                    (x => [new GanttShape(GanttShapeKind.Line, "calm-band ts t-import", x, Mid, X2: x + 26, Y2: Mid)], T["Gantt_Frequent"]),
                    (x => [new GanttShape(GanttShapeKind.Line, "paused-line", x, Mid, X2: x + 26, Y2: Mid)], T["State_Paused"])
                ],
                _ =>
                [
                    (x => [Bar(x, "tf t-import", 10)], T["Gantt_Planned"]),
                    (x => [new GanttShape(GanttShapeKind.Line, "comb ts t-import", x, Mid, X2: x + 26, Y2: Mid),
                           Bar(x + 2, "tf t-import", 10, 1.5), Bar(x + 12, "tf t-import", 10, 1.5), Bar(x + 22, "tf t-import", 10, 1.5)], T["Gantt_Frequent"]),
                    (x => [Bar(x, "hatch", 8, fill: Paused)], T["State_Paused"])
                ]
            };
        }

        return style switch
        {
            ChartStyle.TypeColor =>
            [
                (x => [Bar(x, "tf t-import", 14)], R("Succeeded")),
                (x => [Bar(x, "tf t-import", 14), Bar(x, "edge failed", 4, 26) with { Y = Mid - 7 }], R("Failed")),
                (x => [Bar(x, "tf t-import pulse", 14)], R("Running")),
                (x => [Bar(x, "hatch", 14, fill: Hatch)], R("Cancelled")),
                (x => [new GanttShape(GanttShapeKind.Rect, "low tf t-import", x, Mid + 4, 26, 3, Rx: 1)], R("Skipped")),
                (x => [Triangle(x)], T["Gantt_Missed"])
            ],
            ChartStyle.Heatmap =>
            [
                (x => [Bar(x, "tile succeeded", 14)], R("Succeeded")),
                (x => [Bar(x, "tile failed", 14)], R("Failed")),
                (x => [Bar(x, "tile running", 14)], R("Running")),
                (x => [Bar(x, "tile cancelled", 14)], R("Cancelled")),
                (x => [Bar(x, "tile skipped", 14, opacity: .45)], R("Skipped")),
                (x => [Bar(x, "tile missed", 14)], T["Gantt_Missed"])
            ],
            ChartStyle.Calm =>
            [
                (x => [Bar(x, "failed glow", 16, 10), new GanttShape(GanttShapeKind.Text, "streak", x + 13, Mid + 4, Text: "×3")], R("Failed")),
                (x => [Bar(x + 11, "succeeded", 10, 3)], R("Succeeded")),
                (x => [Bar(x, "running", 10)], R("Running")),
                (x => [Bar(x + 10, "cancelled", 10, 5)], R("Cancelled")),
                (x => [Bar(x + 6, "calm-tick tf t-import", 6, 1.2), Bar(x + 13, "calm-tick tf t-import", 6, 1.2), Bar(x + 20, "calm-tick tf t-import", 6, 1.2)], R("Skipped")),
                (x => [Triangle(x)], T["Gantt_Missed"])
            ],
            _ =>
            [
                (x => [Bar(x, "succeeded")], R("Succeeded")),
                (x => [Bar(x, "failed glow")], R("Failed")),
                (x => [Bar(x, "running glow-run")], R("Running")),
                (x => [Bar(x, "hatch", fill: Hatch)], R("Cancelled")),
                (x => [new GanttShape(GanttShapeKind.Line, "dots", x + 1, Mid, X2: x + 25, Y2: Mid)], R("Skipped")),
                (x => [Triangle(x)], T["Gantt_Missed"])
            ]
        };
    }
}
