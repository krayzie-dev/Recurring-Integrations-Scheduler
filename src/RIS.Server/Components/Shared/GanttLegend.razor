@* Legend of Gantt colours (also printed). *@
<svg class="gantt" height="22" width="100%">
    @{ var x = 0; }
    @foreach (var (css, key) in Items)
    {
        var position = x;
        x += 150;
        if (css == "misfire")
        {
            <polygon class="misfire" points="@(position + 6),4 @(position + 11),14 @(position + 1),14" />
        }
        else
        {
            <rect class="bar @css" x="@position" y="5" width="22" height="10" rx="2" />
        }
        <g><text x="@(position + 28)" y="14">@T[key]</text></g>
    }
</svg>

@code {
    [Parameter] public bool History { get; set; }

    private IEnumerable<(string Css, string Key)> Items => History
        ? [("succeeded", "Result_Succeeded"), ("failed", "Result_Failed"), ("cancelled", "Result_Cancelled"), ("running", "Result_Running"), ("misfire", "Gantt_Missed")]
        : [("planned", "Gantt_Planned"), ("band", "Gantt_Frequent"), ("paused", "State_Paused")];
}
