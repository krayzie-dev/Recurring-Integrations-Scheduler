@using RIS.Server.Services
@* Gantt chart (SVG). Shapes come from GanttPainter (per chart style), colours from CSS classes (ris.css), so light/dark mode
   and the PNG export (which copies computed styles) need no extra code. *@

@if (Timeline.Rows.Count == 0)
{
    <MudText Class="pa-4 mud-text-secondary">@T["Gantt_NoRows"]</MudText>
}
else
{
    var geo = new GanttLayout(Timeline.FromUtc, Timeline.ToUtc, TimeWidth, Zone);
    var rows = Rows();
    var height = GanttLayout.HeaderHeight + rows.Sum(r => r.IsGroup ? GanttLayout.GroupHeight : GanttLayout.RowHeight) + 4;
    var width = geo.Width;
    var now = DateTimeOffset.UtcNow;
    var days = geo.Days();
    var context = new GanttPaintContext(now, Id + "-hatch", Id + "-phatch", _ => "", CellTooltip, (key, arg) => T[key, arg]);
    <div class="gantt-scroll">
        <svg id="@Id" class="@ChartCss(Style, IsDark)" width="@F(width)" height="@F(height)" viewBox="0 0 @F(width) @F(height)" xmlns="http://www.w3.org/2000/svg">
            <GanttPatterns Id="@Id" />
            @* Header: days and hours *@
            @foreach (var hour in geo.Hours(HourStep))
            {
                var x = geo.X(hour);
                <line class="grid" x1="@F(x)" x2="@F(x)" y1="@F(GanttLayout.HeaderHeight - 6)" y2="@F(height)" />
                <g><text class="axis" x="@F(x + 2)" y="@F(GanttLayout.HeaderHeight - 10)">@geo.Label(hour, "HH")</text></g>
            }
            @foreach (var day in days)
            {
                var x = geo.X(day);
                <line class="grid-day" x1="@F(x)" x2="@F(x)" y1="0" y2="@F(height)" />
                <g><text x="@F(x + 4)" y="14" font-weight="600">@geo.Label(day, DayFormat)</text></g>
            }
            @if (days.Count == 0 || days[0] > Timeline.FromUtc)
            {
                <g><text x="@F(GanttLayout.LabelWidth + 4)" y="14" font-weight="600">@geo.Label(Timeline.FromUtc, DayFormat)</text></g>
            }
            <g><text class="axis" x="6" y="@F(GanttLayout.HeaderHeight - 10)">@ZoneLabel</text></g>

            @* Rows *@
            @{
                var y = GanttLayout.HeaderHeight;
                var index = 0;
            }
            @foreach (var row in rows)
            {
                if (row.IsGroup)
                {
                    <rect class="group" x="0" y="@F(y)" width="@F(width)" height="@F(GanttLayout.GroupHeight)" />
                    <g><text class="group-label" x="6" y="@F(y + 15)">@row.Label (@row.Count)</text></g>
                    y += GanttLayout.GroupHeight;
                    continue;
                }

                var rowY = y;
                var data = row.Row!;
                if (index++ % 2 == 1)
                {
                    <rect class="row-alt" x="0" y="@F(rowY)" width="@F(width)" height="@F(GanttLayout.RowHeight)" />
                }
                @if (data.Type is { } type)
                {
                    <rect class="@($"type-mark {GanttPainter.TypeCss(type)}")" x="4" y="@F(rowY + 6)" width="6" height="10" rx="2"><title>@T["JobType_" + type]</title></rect>
                }
                @if (data.Link is not null)
                {
                    <a href="@data.Link"><text x="16" y="@F(rowY + 15)">@Short(data.Label)<title>@data.Key</title></text></a>
                }
                else
                {
                    <g><text x="16" y="@F(rowY + 15)" class="axis">@Short(data.Label)<title>@data.Key</title></text></g>
                }

                @foreach (var shape in GanttPainter.Paint(Style, data, rowY, geo, context with { Tooltip = item => Tooltip(data, item, geo) }))
                {
                    <GanttShapeView Shape="shape" OnClick="OnItemClick" />
                }
                y += GanttLayout.RowHeight;
            }

            @if (now >= Timeline.FromUtc && now < Timeline.ToUtc)
            {
                var nx = geo.X(now);
                <line class="now" x1="@F(nx)" x2="@F(nx)" y1="@F(GanttLayout.HeaderHeight - 6)" y2="@F(height)"><title>@T["Gantt_Now"]</title></line>
            }
            <line class="grid" x1="@F(GanttLayout.LabelWidth)" x2="@F(GanttLayout.LabelWidth)" y1="0" y2="@F(height)" />
        </svg>
    </div>
}

@code {
    [Parameter, EditorRequired] public Timeline Timeline { get; set; } = null!;
    [Parameter] public TimeZoneInfo Zone { get; set; } = TimeZoneInfo.Local;
    [Parameter] public string ZoneLabel { get; set; } = "";
    [Parameter] public double TimeWidth { get; set; } = 1400;
    [Parameter] public int HourStep { get; set; } = 6;
    [Parameter] public string DayFormat { get; set; } = "ddd d.MM";
    [Parameter] public string Id { get; set; } = "gantt";
    [Parameter] public EventCallback<TimelineItem> OnItemClick { get; set; }

    [CascadingParameter] public UiPreferences Prefs { get; set; } = new();
    [CascadingParameter(Name = "IsDark")] public bool IsDark { get; set; }

    private ChartStyle Style => Prefs.Chart;

    /// <summary>Classes of the chart element: style and theme (the colours of both are CSS variables in ris.css).</summary>
    public static string ChartCss(ChartStyle style, bool dark) => $"gantt style-{style.ToString().ToLowerInvariant()} {(dark ? "is-dark" : "is-light")}";

    private sealed record RenderRow(bool IsGroup, string Label, int Count, TimelineRow? Row);

    private List<RenderRow> Rows()
    {
        var result = new List<RenderRow>();
        foreach (var group in Timeline.Rows.GroupBy(r => r.GroupLabel))
        {
            if (!string.IsNullOrEmpty(group.Key)) result.Add(new RenderRow(true, group.Key, group.Count(), null));
            result.AddRange(group.Select(r => new RenderRow(false, r.Label, 0, r)));
        }
        return result;
    }

    /// <summary>CSS class of the job type colour (mark before the name, fill in the "type colour" style).</summary>
    public static string TypeCss(JobType? type) => GanttPainter.TypeCss(type);

    private string Tooltip(TimelineRow row, TimelineItem item, GanttLayout geo) => Tooltip(row.Key, item, geo);

    private string Tooltip(string rowKey, TimelineItem item, GanttLayout geo)
    {
        var time = $"{geo.Label(item.StartUtc, "g")} – {geo.Label(item.EndUtc, "t")}";
        return item.Kind switch
        {
            TimelineItemKind.Missed => $"{rowKey}\n{T["Gantt_Missed"]}: {geo.Label(item.StartUtc, "g")} ({item.Status})",
            TimelineItemKind.Band or TimelineItemKind.BandPaused => $"{rowKey}\n{time}\n{T["Gantt_Every", item.Label ?? ""]} · {T["Gantt_Runs", item.Count]}",
            TimelineItemKind.Planned or TimelineItemKind.PlannedPaused => $"{rowKey}\n{time}" + (item.EndUtc > item.StartUtc ? $"\n{T["Gantt_EstimatedDuration", Ui.UiFormat.Duration(item.EndUtc - item.StartUtc)]}" : ""),
            _ when item.Count > 1 => $"{rowKey}\n{time}\n{T["Gantt_Runs", item.Count]} · {T["Result_" + (item.Status ?? "")]}",
            _ => $"{rowKey}\n{time} ({Ui.UiFormat.Duration(item.EndUtc - item.StartUtc)})\n{T["Result_" + (item.Status ?? "")]}" + (item.Label is null ? "" : $" {item.Label}")
        };
    }

    private string CellTooltip(TimelineCell cell)
    {
        var geo = new GanttLayout(Timeline.FromUtc, Timeline.ToUtc, TimeWidth, Zone);
        var time = $"{geo.Label(cell.StartUtc, "g")} – {geo.Label(cell.EndUtc, "t")}";
        if (cell.Worst == "planned") return $"{time}\n{T["Gantt_Runs", cell.Count]}" + (cell.Paused ? $" · {T["State_Paused"]}" : "");
        var parts = cell.ByResult.OrderByDescending(p => p.Value)
            .Select(p => $"{p.Value} × {(p.Key == "missed" ? T["Gantt_Missed"].Value : T["Result_" + char.ToUpperInvariant(p.Key[0]) + p.Key[1..]].Value)}");
        return $"{time}\n{T["Gantt_Runs", cell.Count]}: {string.Join(", ", parts)}";
    }

    private static string Short(string label) => label.Length > 34 ? label[..33] + "…" : label;

    private static string F(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
