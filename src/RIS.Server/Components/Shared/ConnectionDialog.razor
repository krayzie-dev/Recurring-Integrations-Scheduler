@* D365 instance: name, AOS address and the default app registration (sign-in) of its jobs. The test signs in with the chosen
   app registration and reads D365, before the instance is saved. *@
@using RIS.Core.Options
@using RIS.Server.Components.JobEditor
@inject ConnectionTestService Tests
@inject IRisConfigurationStore Store

<MudDialog>
    <TitleContent>@Title</TitleContent>
    <DialogContent>
        @if (_errors.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@foreach (var error in _errors) { <div class="ris-mono">@error</div> }</MudAlert>
        }

        <MudText Typo="Typo.subtitle2" Class="mb-1">@T["Conn_SectionEnvironment"]</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_name" Label="@T["Field_Name"]" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="!IsNew"
                              HelperText="@(IsNew ? null : T["Conn_NameLocked"].Value)" Error="Missing(_name)" />
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_aos" Label="@T["Field_AosUri"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Placeholder="https://contoso.operations.dynamics.com" HelperText="@T["Conn_AosHint"]" Error="Missing(_aos)" />
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle2" Class="mt-5 mb-1">@T["Conn_SectionAppRegistration"]</MudText>
        <div class="ris-filter-bar">
            <MudSelect T="string" @bind-Value="_appRegistration" Label="@T["Field_AppRegistration"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Error="Missing(_appRegistration)" HelperText="@T["Conn_AppRegistrationHint"]" Class="ris-filter-field ris-filter-search" Style="min-width: 320px">
                @foreach (var registration in Store.Current.AppRegistrations.OrderBy(a => a.Name))
                {
                    <MudSelectItem Value="registration.Name">@registration.Name · @registration.ClientId</MudSelectItem>
                }
            </MudSelect>
            @if (NewAppRegistration is not null)
            {
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAppRegistrationAsync">@T["AppReg_Add"]</MudButton>
            }
        </div>
        @if (Store.Current.FindAppRegistration(_appRegistration) is { } chosen)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1 d-block">
                @T["Field_Tenant"]: @chosen.Tenant · @T["Field_ClientId"]: @chosen.ClientId · @T["Enum_D365AuthMode_" + chosen.AuthMode]
            </MudText>
        }

        <MudPaper Outlined="true" Class="pa-3 mt-4">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@T["Test_ConnectionHint"]</MudText>
            <TestButton Label="@T["Test_Connection"]" Test="TestAsync" />
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">@T["Common_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_saving">@T["Common_Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "";
    /// <summary>The instance (its sign-in is in the app registration).</summary>
    [Parameter] public D365ConnectionOptions Item { get; set; } = null!;
    [Parameter] public bool IsNew { get; set; }
    /// <summary>Saves the instance; returns validation errors.</summary>
    [Parameter] public Func<D365ConnectionOptions, Task<IReadOnlyList<string>>> Save { get; set; } = null!;
    /// <summary>Opens the dialog of a new app registration; returns its name when it was saved.</summary>
    [Parameter] public Func<Task<string?>>? NewAppRegistration { get; set; }

    private string? _name, _aos, _appRegistration;
    private bool _attempted, _saving;
    private IReadOnlyList<string> _errors = [];

    protected override void OnInitialized()
    {
        _name = Item.Name;
        _aos = Item.AosUri?.ToString();
        _appRegistration = Item.AppRegistration
                           ?? (Store.Current.AppRegistrations.Count == 1 ? Store.Current.AppRegistrations[0].Name : null);
    }

    private bool Missing(string? value) => _attempted && string.IsNullOrWhiteSpace(value);

    private D365ConnectionOptions Build() => new()
    {
        Name = _name?.Trim() ?? "",
        AosUri = Uri.TryCreate(_aos?.Trim(), UriKind.Absolute, out var aos) ? aos : null,
        AppRegistration = _appRegistration
    };

    private Task<TestResult> TestAsync() => Tests.D365Async(Build(), null);

    private async Task CreateAppRegistrationAsync()
    {
        if (await NewAppRegistration!() is { } name) _appRegistration = name;
    }

    private async Task SaveAsync()
    {
        _attempted = true;
        if (new[] { _name, _aos, _appRegistration }.Any(string.IsNullOrWhiteSpace)) return;

        _saving = true;
        _errors = await Save(Build());
        _saving = false;
        if (_errors.Count == 0) Dialog.Close(DialogResult.Ok(true));
    }
}
