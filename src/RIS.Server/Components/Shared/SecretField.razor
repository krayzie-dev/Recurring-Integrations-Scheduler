@* Write-only secret: shows whether a value is saved; empty = keep the saved value. *@
<MudTextField T="string" Value="@Value" ValueChanged="ValueChanged" Label="@Label" InputType="InputType.Password" Variant="Variant.Outlined"
              Margin="Margin.Dense" autocomplete="new-password" Error="@Error" ErrorText="@T["Secret_NoneRequired"]"
              Adornment="Adornment.Start" AdornmentIcon="@(Stored ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)"
              AdornmentColor="@(Stored ? Color.Success : Required ? Color.Warning : Color.Default)"
              HelperText="@(Stored ? T["Secret_StoredKeep"] : Required ? T["Secret_NoneRequired"] : T["Secret_NoneOptional"])" />

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    /// <summary>A value is saved on the server.</summary>
    [Parameter] public bool Stored { get; set; }
    /// <summary>Needed when nothing is saved.</summary>
    [Parameter] public bool Required { get; set; } = true;
    /// <summary>Show as error (after an attempt to save without a value).</summary>
    [Parameter] public bool Error { get; set; }
}
