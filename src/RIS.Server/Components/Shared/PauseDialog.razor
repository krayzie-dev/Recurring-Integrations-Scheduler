@* Asks for the reason of a pause; the reason is stored with the pause and shown to everybody. *@
<MudDialog>
    <TitleContent>@T["Pause_Title", Jobs.Count]</TitleContent>
    <DialogContent>
        <MudList T="string" Dense="true" Class="mb-2" Style="max-height: 30vh; overflow: auto">
            @foreach (var job in Jobs)
            {
                <MudListItem T="string" Icon="@Icons.Material.Filled.ChevronRight">@job</MudListItem>
            }
        </MudList>
        @if (Linked.Count > 0)
        {
            <MudCheckBox @bind-Value="_includeLinked" Color="Color.Primary" Label="@T["Paired_PauseToo", Linked.Count]" Class="ml-n2" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary ml-8 mb-2">@string.Join(", ", Linked)</MudText>
        }
        <MudTextField @bind-Value="_reason" Label="@T["Pause_Reason"]" Placeholder="@T["Pause_ReasonHint"]" AutoFocus="true" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">@T["Common_Cancel"]</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="() => Dialog.Close(DialogResult.Ok(new PauseChoice(_reason, _includeLinked)))">@T["Action_Pause"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public IReadOnlyList<string> Jobs { get; set; } = [];

    /// <summary>Linked jobs (monitors) not selected and still running: paused too unless unticked.</summary>
    [Parameter] public IReadOnlyList<string> Linked { get; set; } = [];

    private string? _reason;
    private bool _includeLinked = true;

    public sealed record PauseChoice(string? Reason, bool IncludeLinked);
}
