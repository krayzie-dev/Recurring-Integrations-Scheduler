@page "/audit"
@attribute [Authorize(Policy = RisRoles.CanAdminister)]
@inherits RisPageBase
@using RIS.Persistence
@inject ConfigurationRepository Repository
@inject ExportService Exports
@inject IJSRuntime JS

<PageTitle>RIS 5 – @T["Nav_Audit"]</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">@T["Nav_Audit"]</MudText>
    <MudSpacer />
    <MudTextField T="string" @bind-Value="_search" @bind-Value:after="SearchAsync" Placeholder="@T["Common_Search"]" Immediate="true" DebounceInterval="250"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width: 320px" />
    <MudMenu Icon="@Icons.Material.Filled.Download" title="@T["Common_Export"]" Dense="true">
        <MudMenuItem Icon="@Icons.Material.Filled.TableView" OnClick="@(() => ExportAsync("xlsx"))">@T["Export_Xlsx"]</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.Description" OnClick="@(() => ExportAsync("csv"))">@T["Export_Csv"]</MudMenuItem>
    </MudMenu>
</MudStack>

@* Server-side paging: only one page (with its before/after JSON) is read and sent to the browser. *@
<MudDataGrid @ref="_grid" T="AuditEntry" ServerData="LoadPageAsync" Dense="true" Hover="true" Striped="true" Elevation="0" Outlined="true" RowsPerPage="50">
    <Columns>
        <HierarchyColumn T="AuditEntry" ButtonDisabledFunc="e => e.Before is null && e.After is null" />
        <PropertyColumn Property="e => e.TimestampUtc" Title="@T["Audit_Time"]">
            <CellTemplate>@Prefs.Format(new DateTimeOffset(context.Item.TimestampUtc, TimeSpan.Zero), "G")</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="e => e.User" Title="@T["Audit_User"]" />
        <PropertyColumn Property="e => e.EntityType" Title="@T["Audit_Entity"]" />
        <PropertyColumn Property="e => e.EntityKey" Title="@T["Audit_Key"]" />
        <PropertyColumn Property="e => e.Action" Title="@T["Audit_Action"]" />
    </Columns>
    <ChildRowContent>
        @{ var changes = AuditDiff.Compare(context.Item.Before, context.Item.After); }
        <div class="pa-2">
            @if (changes is not null)
            {
                <MudStack Row="true" Spacing="4" Class="mb-1">
                    <MudSwitch T="bool" @bind-Value="_allFields" Color="Color.Primary" Label="@T["Audit_AllFields"]" Disabled="_json" />
                    <MudSwitch T="bool" @bind-Value="_json" Color="Color.Primary" Label="JSON" />
                </MudStack>
            }
            @if (changes is null || _json)
            {
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.subtitle2">@T["Audit_Before"]</MudText>
                        <pre class="ris-log ris-mono">@AuditDiff.Pretty(context.Item.Before)</pre>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudText Typo="Typo.subtitle2">@T["Audit_After"]</MudText>
                        <pre class="ris-log ris-mono">@AuditDiff.Pretty(context.Item.After)</pre>
                    </MudItem>
                </MudGrid>
            }
            else
            {
                var rows = changes.Where(c => _allFields || c.Kind != AuditChangeKind.Same).ToList();
                @if (rows.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@T["Audit_NoFieldChanges"]</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Bordered="true" Elevation="0" Class="ris-diff">
                        <thead><tr><th>@T["Audit_Field"]</th><th>@T["Audit_Before"]</th><th>@T["Audit_After"]</th></tr></thead>
                        <tbody>
                            @foreach (var change in rows)
                            {
                                <tr class="@($"ris-diff-{change.Kind.ToString().ToLowerInvariant()}")">
                                    <td>
                                        @if (FieldLabel(change.Path) is { } label)
                                        {
                                            <div>@label</div>
                                        }
                                        <div class="ris-mono mud-text-secondary" style="font-size: .75rem">@change.Path</div>
                                    </td>
                                    <td class="ris-mono ris-diff-before">@Value(change.Before)</td>
                                    <td class="ris-mono ris-diff-after">@Value(change.After)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            }
        </div>
    </ChildRowContent>
    <PagerContent><MudDataGridPager T="AuditEntry" PageSizeOptions="[50, 100, 500]" /></PagerContent>
</MudDataGrid>

@code {
    protected override bool RefreshOnRuns => false;

    private MudDataGrid<AuditEntry>? _grid;
    private string? _search;
    private bool _allFields, _json;

    protected override TimeSpan? RefreshInterval => null;

    /// <summary>The grid loads its pages itself; configuration changes reload the current page.</summary>
    protected override Task LoadAsync() => _grid?.ReloadServerData() ?? Task.CompletedTask;

    private async Task<GridData<AuditEntry>> LoadPageAsync(GridState<AuditEntry> state, CancellationToken cancellationToken)
    {
        var (items, total) = await Repository.QueryAuditAsync(state.Page * state.PageSize, state.PageSize, _search, cancellationToken);
        return new GridData<AuditEntry> { Items = items, TotalItems = total };
    }

    private Task SearchAsync() => _grid?.ReloadServerData() ?? Task.CompletedTask;

    /// <summary>Label of the field in the user's language (last part of the path, e.g. "timeout"), when there is one.</summary>
    private string? FieldLabel(string path)
    {
        var name = path[(path.LastIndexOf('.') + 1)..];
        if (name.Length == 0) return null;
        var label = T["Field_" + char.ToUpperInvariant(name[0]) + name[1..]];
        return label.ResourceNotFound ? null : label.Value;
    }

    private string Value(string? value) => value switch
    {
        null => "–",
        ConfigurationRepository.AuditSecretChanged => T["Audit_SecretChanged"],
        ConfigurationRepository.AuditSecretStored => T["Audit_SecretStored"],
        _ => value
    };

    /// <summary>All entries matching the search (up to 50 000), not only the page on screen.</summary>
    private async Task ExportAsync(string format)
    {
        var (items, _) = await Repository.QueryAuditAsync(0, 50_000, _search, Disposed);
        await ExportService.DownloadAsync(JS, Exports.Audit(items, format, Prefs.Zone));
    }
}
