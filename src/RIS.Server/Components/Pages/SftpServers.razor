@page "/sftp-servers"
@attribute [Authorize(Policy = RisRoles.CanAdminister)]
@inherits RisPageBase
@using RIS.Core.Options
@using RIS.Persistence
@inject ConfigurationRepository Repository
@inject IRisConfigurationStore Store
@inject ConnectionTestService Tests
@inject ConnectionTestResults TestResults

<PageTitle>RIS 5 – @T["Nav_SftpServers"]</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">@T["Nav_SftpServers"]</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.NetworkCheck" OnClick="TestAllAsync" Disabled="_items.Count == 0 || _running.Count > 0">@T["Test_All"]</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">@T["Sftp_Add"]</MudButton>
</MudStack>

<MudDataGrid T="SftpServerOptions" Items="_items" Dense="true" Hover="true" Elevation="0" Outlined="true" Loading="Loading">
    <Columns>
        <PropertyColumn Property="c => c.Name" Title="@T["Field_Name"]" />
        <PropertyColumn Property="c => c.Host" Title="@T["Field_Host"]" />
        <PropertyColumn Property="c => c.Port" Title="@T["Field_Port"]" />
        <PropertyColumn Property="c => c.UserName" Title="@T["Field_UserName"]" />
        <TemplateColumn T="SftpServerOptions" Title="@T["Conn_Method"]">
            <CellTemplate>
                @if (context.Item.UseKey)
                {
                    <MudTooltip Text="@context.Item.KeyPath"><span>@T["Sftp_AuthKey"]</span></MudTooltip>
                }
                else
                {
                    @T["Sftp_AuthPassword"]
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="SftpServerOptions" Title="@T["Secret"]">
            <CellTemplate>
                @if (HasSecret(context.Item))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Lock">@T["Secret_Set"]</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.LockOpen">@T["Secret_Missing"]</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="SftpServerOptions" Title="@T["Test_Last"]">
            <CellTemplate>
                <TestStatus Last="TestResults.Get(TestTarget.Sftp, context.Item.Name)" Running="_running.Contains(context.Item.Name)" OnTest="() => TestAsync(context.Item.Name)" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="SftpServerOptions" Title="@T["Usage_Jobs"]">
            <CellTemplate>
                @{ var jobs = UsedBy(context.Item.Name); }
                <MudTooltip Text="@string.Join(", ", jobs)" Disabled="jobs.Count == 0">
                    <MudLink Href="@($"/jobs")">@jobs.Count</MudLink>
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="SftpServerOptions" CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAsync(context.Item)" title="@T["Action_Edit"]" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context.Item)" title="@T["Common_Delete"]" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>

@code {
    private IReadOnlyList<SftpServerOptions> _items = [];
    private readonly HashSet<string> _running = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task LoadAsync() =>
        _items = (await Repository.LoadAsync()).SftpServers.Select(ConfigurationRepository.WithoutSecrets).OrderBy(c => c.Name).ToList();

    private bool StoredPassword(string name) => Store.Current.FindSftpServer(name) is { } s && !SecretPlaceholder.IsPlaceholderOrEmpty(s.Password);

    private bool StoredKeyPassphrase(string name) => Store.Current.FindSftpServer(name) is { } s && !SecretPlaceholder.IsPlaceholderOrEmpty(s.KeyPassphrase);

    /// <summary>Whether the secret needed by the authentication mode is stored (checked on the server; secrets never reach the browser).</summary>
    private bool HasSecret(SftpServerOptions s) => s.UseKey || StoredPassword(s.Name); // a key without passphrase needs no secret

    /// <summary>Jobs with an SFTP transfer (inbound/outbound) to this server.</summary>
    private IReadOnlyList<string> UsedBy(string name) =>
        Store.Current.Jobs.Where(j => j.Options is not null && j.Options.GetType().GetProperties()
                .Where(p => p.PropertyType == typeof(SftpTransferOptions))
                .Any(p => p.GetValue(j.Options) is SftpTransferOptions t && string.Equals(t.Server, name, StringComparison.OrdinalIgnoreCase)))
            .Select(j => j.Key).ToList();

    private async Task TestAsync(string name)
    {
        _running.Add(name);
        StateHasChanged();
        try { await Tests.SftpAsync(name, null, Disposed); }
        finally
        {
            _running.Remove(name);
            StateHasChanged();
        }
    }

    /// <summary>Tests every server, four at a time; each row updates when its test ends.</summary>
    private async Task TestAllAsync()
    {
        using var slots = new SemaphoreSlim(4);
        await Task.WhenAll(_items.Select(async s =>
        {
            await slots.WaitAsync();
            try { await TestAsync(s.Name); }
            finally { slots.Release(); }
        }));
    }

    private async Task EditAsync(SftpServerOptions? existing)
    {
        var item = existing is null
            ? new SftpServerOptions { Name = "", Host = "", UserName = "" }
            : ConfigurationRepository.WithoutSecrets(existing);
        var originalName = existing?.Name;
        var dialog = await Dialogs.ShowAsync<SftpServerDialog>(T["Nav_SftpServers"], new DialogParameters<SftpServerDialog>
        {
            { d => d.Title, existing is null ? T["Sftp_Add"] : existing.Name },
            { d => d.Item, item },
            { d => d.IsNew, existing is null },
            { d => d.StoredPassword, existing is not null && StoredPassword(existing.Name) },
            { d => d.StoredKeyPassphrase, existing is not null && StoredKeyPassphrase(existing.Name) },
            { d => d.Save, s => SaveAsync(s, originalName) }
        }, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(T["Saved"], Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task<IReadOnlyList<string>> SaveAsync(SftpServerOptions server, string? originalName)
    {
        if (originalName is not null && !string.Equals(originalName, server.Name, StringComparison.OrdinalIgnoreCase))
        {
            return [T["Reference_NoRename"]];
        }
        try
        {
            await Repository.SaveSftpServerAsync(server, UserName);
            return [];
        }
        catch (ConfigurationValidationException ex)
        {
            return ex.Errors;
        }
    }

    private async Task DeleteAsync(SftpServerOptions server)
    {
        // Used by jobs: explain instead of a validation error after the attempt.
        var jobs = UsedBy(server.Name);
        if (jobs.Count > 0)
        {
            await ConfirmAsync(T["Sftp_InUseTitle", server.Name], T["Sftp_InUseText"], T["Common_Close"], Color.Primary, jobs);
            return;
        }
        if (!await ConfirmAsync(T["Reference_DeleteTitle", server.Name], T["Reference_DeleteText"], T["Common_Delete"], Color.Error)) return;
        try
        {
            await Repository.DeleteSftpServerAsync(server.Name, UserName);
            await ReloadAsync();
        }
        catch (ConfigurationValidationException ex)
        {
            Snackbar.Add(string.Join("; ", ex.Errors), Severity.Error, o => o.RequireInteraction = true);
        }
    }
}
